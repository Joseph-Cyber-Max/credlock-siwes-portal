// Additional portal actions used by the upgraded role dashboards.
function profile_(token){const u=require_(token);const student=rows_(SHEETS.STUDENTS).find(function(x){return String(x.UserID)===String(u.UserID);});return ok_({user:u,student:student||null},'Profile loaded.');}
function updateMyProfile_(token,p){const u=require_(token);const student=rows_(SHEETS.STUDENTS).find(function(x){return String(x.UserID)===String(u.UserID);});if(!student)return err_('Student profile not found.','NOT_FOUND');const allowed=['Phone','Email','Address','Level'];const clean={UpdatedAt:new Date()};allowed.forEach(function(k){if(Object.prototype.hasOwnProperty.call(p,k))clean[k]=String(p[k]??'').trim();});if(clean.Email&&rows_(SHEETS.USERS).some(function(x){return String(x.Email||'').toLowerCase()===clean.Email.toLowerCase()&&String(x.UserID)!==String(u.UserID);} ))return err_('Email is already in use.','DUPLICATE');updateById_(SHEETS.STUDENTS,'StudentID',student.StudentID,clean);const userClean={UpdatedAt:new Date()};if(clean.Email)userClean.Email=clean.Email;if(clean.Phone)userClean.Phone=clean.Phone;updateById_(SHEETS.USERS,'UserID',u.UserID,userClean);audit_(u,'UPDATE_PROFILE','PROFILE',student.StudentID,'Student updated personal profile');return ok_({},'Profile updated.');}
function notifyRole_(role,title,message,type){const users=rows_(SHEETS.USERS).filter(function(u){return String(u.Role||'').toUpperCase()===String(role||'').toUpperCase()&&String(u.Status||'').toUpperCase()==='ACTIVE';});users.forEach(function(u){notifyUser_(u.UserID,title,message,type||'INFO');});}
function announceRegistration_(student){notifyRole_('SUPER_ADMIN','New student registration','A new student registration is waiting for approval: '+String(student.FullName||student.Email||student.StudentID),'APPROVAL');notifyRole_('HR','New student registration','A new student registration is waiting for HR review: '+String(student.FullName||student.Email||student.StudentID),'APPROVAL');}
function dispatchPortalActions_(action,token,p){switch(action){case 'profile':return profile_(token);case 'updateMyProfile':return updateMyProfile_(token,p);default:return null;}}
