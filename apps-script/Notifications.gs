// Notification API for portal alert center.
function notifications_(token){const u=require_(token);ensureSchema_();return ok_(rows_(SHEETS.NOTIFICATIONS).filter(x=>String(x.UserID||'')===String(u.UserID||'')).sort(function(a,b){return String(b.CreatedAt).localeCompare(String(a.CreatedAt));}),'Notifications loaded.');}
function unreadCount_(token){const u=require_(token);ensureSchema_();return ok_({count:rows_(SHEETS.NOTIFICATIONS).filter(x=>String(x.UserID||'')===String(u.UserID||'')&&String(x.Read).toUpperCase()!=='TRUE').length},'Unread count loaded.');}
function markNotificationRead_(token,p){const u=require_(token);ensureSchema_();const id=String(p.NotificationID||p.id||'');const row=rows_(SHEETS.NOTIFICATIONS).find(x=>String(x.NotificationID)===id&&String(x.UserID)===String(u.UserID));if(!row)return err_('Notification not found.','NOT_FOUND');updateById_(SHEETS.NOTIFICATIONS,'NotificationID',id,{Read:true});return ok_({},'Notification marked read.');}
function markAllNotificationsRead_(token){const u=require_(token);ensureSchema_();const sh=SpreadsheetApp.openById(SHEET_ID).getSheetByName(SHEETS.NOTIFICATIONS),v=sh.getDataRange().getValues();if(v.length<2)return ok_({},'No notifications.');const h=v[0].map(String),uid=h.indexOf('UserID'),read=h.indexOf('Read');for(let i=1;i<v.length;i++){if(String(v[i][uid])===String(u.UserID))sh.getRange(i+1,read+1).setValue(true);}return ok_({},'Notifications marked read.');}
function dispatchNotifications_(action,token,p){switch(action){case 'notifications':return notifications_(token);case 'unreadCount':return unreadCount_(token);case 'markNotificationRead':return markNotificationRead_(token,p);case 'markAllNotificationsRead':return markAllNotificationsRead_(token,p);default:return null;}}
